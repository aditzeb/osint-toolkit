# Every setting is optional. Copy this file to .env only when needed.
SNOOP_DATA_DIR=
SNOOP_CONCURRENCY=30
SNOOP_PER_HOST_CONCURRENCY=3
SNOOP_HTTP_TIMEOUT=12
SNOOP_HTTP_RETRIES=2
# Maximum wall time for one lead and for CPU-bound document parsing.
SNOOP_ACTION_TIMEOUT=45
SNOOP_DOCUMENT_PARSE_TIMEOUT=8
# Skip an unanswered question after this many seconds and keep investigating (0 = wait).
SNOOP_QUESTION_TIMEOUT=60
SNOOP_WEB_HOST=127.0.0.1
SNOOP_WEB_PORT=8000

# Investigation workflow
# Preset budgets: quick | standard | deep (searches, page fetches, probes, pivots)
SNOOP_WORKFLOW_PRESET=standard
# Common Crawl index used by bounded archive lookups
SNOOP_CC_INDEX=CC-MAIN-2026-34

# Web search providers (at least one enables web discovery)
# Google results are provided by SerpAPI and always labelled "Google via SerpAPI".
SERPAPI_KEY=
# Brave Search is a separate index used as fallback or cross-check, never
# relabelled as Google.
BRAVE_SEARCH_API_KEY=
# Preferred engine: google | brave. The other configured engine is used as a
# labelled fallback when the first is unavailable (disable with =0).
SNOOP_SEARCH_ENGINE=google
SNOOP_SEARCH_FALLBACK=1
# Optional search locale (hl= language, gl= region)
SNOOP_SEARCH_HL=
SNOOP_SEARCH_GL=

# Presenter mode
SNOOP_PRESENTER_MODE=false
SNOOP_REDACT_VALUES=

# Optional enrichment providers
GITHUB_TOKEN=
HIBP_API_KEY=

# Optional AI provider; SNOOP never silently switches providers.
# Explicit selection: openai | anthropic | gemini | ollama. Blank preserves legacy key precedence.
SNOOP_AI_PROVIDER=
# Modern reasoning models (GPT-5/6 and o-series); medium is the interactive default.
SNOOP_REASONING_EFFORT=medium
SNOOP_AI_MAX_OUTPUT_TOKENS=16000
SNOOP_AI_TIMEOUT=180
# Quality-oriented setup: OPENAI_MODEL=gpt-6-astra (higher cost).
# Balanced setup: OPENAI_MODEL=gpt-5.6-terra. Existing model pins are respected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# Legacy-compatible alias; set either this or ANTHROPIC_API_KEY, not both.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Local Ollama server; no API key required. Base URL defaults to localhost if unset.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
